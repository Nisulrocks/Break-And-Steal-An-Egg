----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function notify(title, content)
	Rayfield:Notify({ Title = title, Content = content, Duration = 3 })
end

local function setStatus(text)
	if statusLabel then
		pcall(function()
			statusLabel:Set("Status: " .. text)
		end)
	end
end

local function parseMoney(text)
	if type(text) ~= "string" then
		return nil
	end

	-- "$11.1B/s" -> "11.1B"
	local cleaned = text:gsub("[%$,%s]", ""):gsub("/%a+$", "")
	local number, suffix = cleaned:match("^(%d+%.?%d*)(%a*)$")
	if not number then
		return nil
	end

	local multiplier = 1
	if suffix ~= "" then
		multiplier = SUFFIXES[suffix:lower()]
		if not multiplier then
			return nil
		end
	end

	return tonumber(number) * multiplier
end

local function getPosition(instance)
	if not instance then
		return nil
	end
	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	if instance:IsA("BasePart") or instance:IsA("Model") then
		return instance:GetPivot().Position
	end
	return nil
end

local function flatDistance(a, b)
	return ((a - b) * Vector3.new(1, 0, 1)).Magnitude
end

local function findChildPath(root, names)
	local current = root
	for _, name in ipairs(names) do
		if not current then
			return nil
		end
		current = current:FindFirstChild(name)
	end
	return current
end

----------------------------------------------------------------------
-- Solid-only raycasting
----------------------------------------------------------------------

-- Only solid geometry should ever block movement. Anything the character walks
-- through - eggs, animals, gems, decoration - must be invisible to every probe.
--
-- RaycastParams.RespectCanCollide does exactly that, but it is a newer
-- property: on an engine without it the assignment throws and the raycast
-- quietly goes back to hitting noclip parts. So detect support once, and fall
-- back to skipping pass-through hits by hand.
local RESPECTS_CAN_COLLIDE = pcall(function()
	RaycastParams.new().RespectCanCollide = true
end)

local PASSTHROUGH_SKIP_LIMIT = 8

-- Returns the first hit the character would actually collide with, or nil.
local function castSolid(origin, direction, distance, params)
	if RESPECTS_CAN_COLLIDE then
		return Workspace:Raycast(origin, direction * distance, params)
	end

	local from = origin
	local remaining = distance

	for _ = 1, PASSTHROUGH_SKIP_LIMIT do
		local result = Workspace:Raycast(from, direction * remaining, params)
		if not result then
			return nil
		end

		local part = result.Instance
		if not part or part.CanCollide then
			return result
		end

		-- Step just past the pass-through surface and keep looking.
		local travelled = (result.Position - from).Magnitude + 0.1
		remaining -= travelled
		if remaining <= 0 then
			return nil
		end
		from = result.Position + direction * 0.1
	end

	return nil
end

local function makeRaycastParams(ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	if RESPECTS_CAN_COLLIDE then
		params.RespectCanCollide = true
	end
	return params
end

-- Drops a point onto the ground so pathfinding has a walkable goal (eggs and animals sit above the floor)
local function groundPoint(position, ignore)
	local params = makeRaycastParams(ignore)

	-- A noclipped egg resting on the floor must not catch this ray, or the goal
	-- ends up floating above the ground instead of on it.
	local result = castSolid(position + Vector3.new(0, 3, 0), Vector3.new(0, -1, 0), 200, params)
	if result then
		return result.Position
	end
	return position
end

local function getCharacter()
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return char, hum, root
	end
	return nil
end

----------------------------------------------------------------------
-- World lookups
----------------------------------------------------------------------

local function findMyPlot()
	local plots = Workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in ipairs(plots:GetChildren()) do
		if tostring(plot:GetAttribute("OwnerUserId")) == tostring(LocalPlayer.UserId) then
			return plot
		end
	end
	return nil
end

local function getZoneBuild(zone)
	local build = Workspace:FindFirstChild("Build")
	local zoneBuilds = build and build:FindFirstChild("ZoneBuilds")
	return zoneBuilds and zoneBuilds:FindFirstChild(zone.Build)
end

-- Hitboxes are named by zone number (e.g. ZoneHitboxes["13"]) and stay loaded even when the zone itself isn't
local function getZoneHitbox(zone)
	local build = Workspace:FindFirstChild("Build")
	local hitboxes = build and build:FindFirstChild("ZoneHitboxes")
	if not hitboxes then return nil end
	local number = zone.Number or tonumber(zone.Build:match("%d+"))
	return number and hitboxes:FindFirstChild(tostring(number))
end

local function getZoneEggsFolder(zone)
	local zoneBuild = getZoneBuild(zone)
	return zoneBuild and zoneBuild:FindFirstChild("Eggs")
end

local function getEggNames(zone)
	local names = {}
	local eggs = ReplicatedStorage:FindFirstChild("Eggs")
	local normal = eggs and eggs:FindFirstChild("NormalEggs")
	local folder = (normal and zone.EggFolder) and normal:FindFirstChild(zone.EggFolder) or nil
	if folder then
		for _, egg in ipairs(folder:GetChildren()) do
			table.insert(names, egg.Name)
		end
	end
	table.sort(names)
	return names
end

local function isCarrying()
	local carried = Workspace:FindFirstChild("CarriedAnimals")
	return carried ~= nil and #carried:GetChildren() > 0
end

-- Reads "$11.1B/s" from the animal's overhead
local function readCashPerSecond(animal)
	local label = findChildPath(animal, {
		"RootPart", "AnimalOverheadAttachment", "AnimalOverhead", "CashPerSecond", "CashPerSecond",
	})
	if label and label:IsA("TextLabel") then
		return parseMoney(label.Text)
	end
	return nil
end

-- Highest earning hatched animal that meets the threshold and hasn't failed too many times
local function findTargetAnimal()
	local pickups = Workspace:FindFirstChild("AnimalPickups")
	if not pickups then
		return nil
	end

	local best, bestValue = nil, -1
	for _, animal in ipairs(pickups:GetChildren()) do
		local value = readCashPerSecond(animal)
		local attempts = state.stealAttempts[animal] or 0
		if value and value >= state.minCps and value > bestValue and attempts < CONFIG.MaxStealAttempts then
			best, bestValue = animal, value
		end
	end
	return best
end

-- The steal prompts are direct children of workspace, so pick the one closest to the animal
local function findClosestStealPrompt(position)
	local bestPrompt, bestDistance = nil, math.huge
	for _, child in ipairs(Workspace:GetChildren()) do
		local holder = child:FindFirstChild("StealPrompt")
		if holder then
			local prompt = holder:IsA("ProximityPrompt") and holder or holder:FindFirstChildWhichIsA("ProximityPrompt", true)
			local promptPosition = getPosition(holder) or getPosition(child)
			if prompt and promptPosition then
				local distance = (promptPosition - position).Magnitude
				if distance < bestDistance then
					bestPrompt, bestDistance = prompt, distance
				end
			end
		end
	end
	return bestPrompt
end

local function firePrompt(prompt)
	if fireproximityprompt then
		fireproximityprompt(prompt)
	else
		notify("Autofarm", "fireproximityprompt is not supported by this executor")
	end
end

-- Egg HP text looks like "0/1.3Qa HP" when broken
-- Finds the HP text inside the egg's EggInfoUi (the nesting under it can vary, so search for it)
local function findEggHpLabel(egg)
	local infoUi = egg:FindFirstChild("EggInfoUi", true)
	return infoUi and infoUi:FindFirstChild("HpAmount", true)
end

local function getEggHpText(egg)
	local label = findEggHpLabel(egg)
	if not label then
		return nil
	end
	local ok, text = pcall(function()
		return label.Text
	end)
	if ok and type(text) == "string" then
		return text
	end
	return nil
end

-- HP text looks like "0/1.3Qa HP" when broken. Once an egg breaks its HP text is removed, so missing text also means broken.
local function isEggBroken(egg)
	local text = getEggHpText(egg)
	if not text then
		return true
	end
	local current = text:match("^%s*([%d%.]+)")
	return current ~= nil and tonumber(current) == 0
end

----------------------------------------------------------------------
-- Movement
----------------------------------------------------------------------

-- Holds W/A/S/D with real key presses. Keys are only sent when a key's state changes.
local MOVE_KEYS = {
	W = Enum.KeyCode.W,
	A = Enum.KeyCode.A,
	S = Enum.KeyCode.S,
	D = Enum.KeyCode.D,
}
local heldKeys = {}

local function setKeyHeld(name, held)
	if heldKeys[name] == held then
		return
	end
	heldKeys[name] = held
	VirtualInputManager:SendKeyEvent(held, MOVE_KEYS[name], false, game)
end

local function releaseMoveKeys()
	for name in pairs(MOVE_KEYS) do
		setKeyHeld(name, false)
	end
end

-- Flattens a vector onto the ground, falling back if it points straight up or down
local function flatUnit(vector, fallback)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude < 0.01 then
		return fallback
	end
	return flat.Unit
end

----------------------------------------------------------------------
-- Obstacle probing
----------------------------------------------------------------------

-- Eggs, animals and gems are the things we are trying to walk INTO, and they
-- are noclipped anyway. Treating them as obstacles made the bot steer around
-- its own targets, which breaks farming outright.
-- Rebuilt on a timer rather than per call: this runs inside the steering loop,
-- so repeating these lookups every frame is pure waste.
local ignoreCache = { list = nil, char = nil, time = 0 }

local function buildIgnoreList(char)
	if ignoreCache.list and ignoreCache.char == char and os.clock() - ignoreCache.time < 2 then
		return ignoreCache.list
	end

	local ignore = { char }

	for _, name in ipairs({ "EggGemDrops", "CarriedAnimals", "AnimalPickups", "Debris" }) do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			ignore[#ignore + 1] = folder
		end
	end

	-- Only the zone's Eggs folder, never the whole zone build: the build also
	-- holds the walls and scenery we genuinely do need to path around.
	local zoneEggs = state.zone and getZoneEggsFolder(state.zone)
	if zoneEggs then
		ignore[#ignore + 1] = zoneEggs
	end

	ignoreCache.list = ignore
	ignoreCache.char = char
	ignoreCache.time = os.clock()
	return ignore
end

-- Probes share the solid-only params helper defined above, so every obstacle
-- test agrees on what counts as solid.
local function makeProbeParams(ignore)
	return makeRaycastParams(ignore)
end

-- A single centre ray misses anything the character's shoulders would clip, and
-- a knee-height ray walks straight into railings. Probe the body's width at two
-- heights instead.
local BODY_HALF_WIDTH = 1.6
local PROBE_HEIGHTS = { 1.0, 3.0 }

local function directionBlocked(origin, direction, distance, ignore)
	local params = makeProbeParams(ignore)

	local side = Vector3.new(-direction.Z, 0, direction.X) * BODY_HALF_WIDTH

	for _, offset in ipairs({ Vector3.zero, side, -side }) do
		for _, height in ipairs(PROBE_HEIGHTS) do
			local from = origin + offset + Vector3.new(0, height, 0)
			if castSolid(from, direction, distance, params) then
				return true
			end
		end
	end

	return false
end

-- Sweep outward from dead ahead, alternating sides, so the heading we take is
-- the smallest deviation from the one we wanted that is actually clear.
local AVOID_ANGLES = { 0, 18, -18, 36, -36, 55, -55, 75, -75, 95, -95 }
local AVOID_LOOKAHEAD = 10

-- Returns a clear direction to walk, or nil when every direction is blocked.
local function clearHeading(root, targetPoint, char)
	local desired = flatUnit(targetPoint - root.Position, nil)
	if not desired then
		return nil
	end

	local distance = math.min(AVOID_LOOKAHEAD, flatDistance(root.Position, targetPoint))
	if distance < 2 then
		return desired
	end

	local ignore = buildIgnoreList(char)

	for _, angle in ipairs(AVOID_ANGLES) do
		local direction = CFrame.Angles(0, math.rad(angle), 0) * desired
		if not directionBlocked(root.Position, direction, distance, ignore) then
			return direction
		end
	end

	return nil
end

----------------------------------------------------------------------
-- Steering
----------------------------------------------------------------------

-- Presses W/A/S/D relative to the camera, the same way the default controls do, so the character heads toward the point
local function steerToward(point)
	local _, _, root = getCharacter()
	if not root then
		return
	end

	local camera = Workspace.CurrentCamera
	local forward = flatUnit(camera.CFrame.LookVector, Vector3.new(0, 0, -1))
	local right = flatUnit(camera.CFrame.RightVector, Vector3.new(1, 0, 0))

	local toPoint = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
	if toPoint.Magnitude < 0.1 then
		releaseMoveKeys()
		return
	end

	local direction = toPoint.Unit
	local alongForward = direction:Dot(forward)
	local alongRight = direction:Dot(right)

	-- A lower threshold than 0.38 keeps diagonals engaged, so the character
	-- curves around corners instead of alternating between two keys.
	setKeyHeld("W", alongForward > 0.25)
	setKeyHeld("S", alongForward < -0.25)
	setKeyHeld("D", alongRight > 0.25)
	setKeyHeld("A", alongRight < -0.25)
end

-- Steers at the waypoint, but deviates around anything standing in the way.
-- Returns false when boxed in on every heading, so the caller can recover.
--
-- The heading is re-evaluated on a short timer rather than every frame. Dead
-- ahead costs six raycasts, but a fully blocked sweep costs sixty-six, and
-- this runs inside the per-frame steering loop.
local headingCache = { direction = nil, time = 0, open = true }
local HEADING_REFRESH = 0.08

local function steerAvoiding(point, char)
	local _, _, root = getCharacter()
	if not root then
		return true
	end

	if os.clock() - headingCache.time >= HEADING_REFRESH then
		headingCache.direction = clearHeading(root, point, char)
		headingCache.open = headingCache.direction ~= nil
		headingCache.time = os.clock()
	end

	if not headingCache.direction then
		steerToward(point)
		return false
	end

	-- Aim at a point along the clear heading rather than the waypoint itself.
	steerToward(root.Position + headingCache.direction * 8)
	return headingCache.open
end

-- True when nothing is in the way between two points, checked across the
-- character's width at knee and chest height
local function clearLine(from, to, char)
	local delta = to - from
	local flat = Vector3.new(delta.X, 0, delta.Z)
	if flat.Magnitude < 0.01 then
		return true
	end

	local ignore = buildIgnoreList(char)
	local direction = flat.Unit
	local distance = flat.Magnitude
	local side = Vector3.new(-direction.Z, 0, direction.X) * BODY_HALF_WIDTH
	local params = makeProbeParams(ignore)

	for _, offset in ipairs({ Vector3.zero, side, -side }) do
		for _, height in ipairs(PROBE_HEIGHTS) do
			local origin = from + offset + Vector3.new(0, height, 0)
			local result = castSolid(origin, direction, distance, params)
			-- A hit right at the destination is the target itself, which is fine
			if result and (result.Position - (to + Vector3.new(0, height, 0))).Magnitude >= 3 then
				return false
			end
		end
	end

	return true
end

----------------------------------------------------------------------
-- Path following
----------------------------------------------------------------------

-- Recomputing a path on every goTo iteration is what made movement stutter:
-- ComputeAsync yields, and the character stood still through it. The route is
-- cached instead and only rebuilt when it is actually stale, so walking
-- continues across iterations.
local pathCache = {
	waypoints = nil,
	index = 1,
	goal = nil,
	time = 0,
	blocked = false,
	connection = nil,
}

local PATH_MAX_AGE = 3
local PATH_GOAL_DRIFT = 8

local function clearPathCache()
	if pathCache.connection then
		pathCache.connection:Disconnect()
		pathCache.connection = nil
	end
	pathCache.waypoints = nil
	pathCache.index = 1
	pathCache.goal = nil
	pathCache.blocked = false
end

local function pathCacheUsable(goal)
	if pathCache.blocked or not pathCache.waypoints then
		return false
	end
	if pathCache.index > #pathCache.waypoints then
		return false
	end
	if os.clock() - pathCache.time > PATH_MAX_AGE then
		return false
	end
	-- A target that has moved far enough needs a new route.
	return pathCache.goal ~= nil and flatDistance(pathCache.goal, goal) <= PATH_GOAL_DRIFT
end

local function buildPath(goal, char, root)
	clearPathCache()

	-- Close with a clear line: walk straight there. This skips the path computation pause.
	if flatDistance(root.Position, goal) < 15 and clearLine(root.Position, goal, char) then
		state.lastPath = "Direct"
		pathCache.waypoints = { { Position = goal, Action = Enum.PathWaypointAction.Walk } }
		pathCache.index = 1
		pathCache.goal = goal
		pathCache.time = os.clock()
		return
	end

	local path = PathfindingService:CreatePath(PATH_PARAMS)
	local ok = pcall(function()
		path:ComputeAsync(root.Position, goal)
	end)

	state.lastPath = ok and path.Status.Name or "ComputeError"

	if ok and path.Status == Enum.PathStatus.Success then
		pathCache.waypoints = path:GetWaypoints()
		pathCache.connection = path.Blocked:Connect(function()
			pathCache.blocked = true
		end)
	else
		-- No usable path: head straight at the goal and let avoidance handle it
		pathCache.waypoints = { { Position = goal, Action = Enum.PathWaypointAction.Walk } }
	end

	pathCache.index = 1
	pathCache.goal = goal
	pathCache.time = os.clock()
end

-- Follows the cached route, steering around obstacles. Deliberately does NOT
-- release the movement keys on exit: goTo calls this repeatedly, and releasing
-- between calls is what produced stop-start walking. goTo releases once, when
-- the whole journey ends.
local function followPath(goal, char, shouldStop, finalReach)
	local _, hum, root = getCharacter()
	if not hum or not root then
		return
	end

	if not pathCacheUsable(goal) then
		buildPath(goal, char, root)
	end

	local waypoints = pathCache.waypoints
	if not waypoints then
		return
	end

	local function cancelled()
		return shouldStop() or LocalPlayer.Character ~= char or hum.Health <= 0
	end

	local reach = math.clamp(hum.WalkSpeed * 0.15, CONFIG.WaypointReach, 16)
	local waypointStart = os.clock()
	local lastPosition = root.Position
	local lastProgress = os.clock()
	local sidestepUntil = 0

	while pathCache.index <= #waypoints and not cancelled() do
		if pathCache.blocked then
			-- The route is invalid now, but keep the keys held: the next call
			-- recomputes while the character is still moving.
			break
		end

		local waypoint = waypoints[pathCache.index]
		-- The final waypoint is the target itself, so it uses the tight reach instead of the route reach
		local threshold = pathCache.index == #waypoints and finalReach or reach

		if flatDistance(root.Position, waypoint.Position) <= threshold then
			pathCache.index += 1
			waypointStart = os.clock()
			-- New waypoint means a new direction; do not steer on the old one.
			headingCache.time = 0
			if pathCache.index <= #waypoints and waypoints[pathCache.index].Action == Enum.PathWaypointAction.Jump then
				hum.Jump = true
			end
		elseif os.clock() - waypointStart > CONFIG.WaypointTimeout then
			-- This waypoint is not working out; force a rebuild next call.
			pathCache.blocked = true
			break
		else
			if os.clock() < sidestepUntil then
				-- Committed to a sidestep: hold it so we clear the corner
				-- instead of oscillating back into it.
				task.wait()
				continue
			end

			local open = steerAvoiding(waypoint.Position, char)

			-- Jump at a low obstacle, but only when genuinely stalled.
			if os.clock() - waypointStart > 0.5 and root.AssemblyLinearVelocity.Magnitude < 1 then
				hum.Jump = true
			end

			if not open then
				-- Every heading blocked: commit to a sidestep for a moment.
				local desired = flatUnit(waypoint.Position - root.Position, Vector3.new(0, 0, -1))
				local side = Vector3.new(-desired.Z, 0, desired.X)
				if math.random() < 0.5 then
					side = -side
				end
				steerToward(root.Position + side * 12)
				sidestepUntil = os.clock() + 0.45
				hum.Jump = true
			end

			-- Not moving at all for a while means the cached route is wrong.
			if flatDistance(root.Position, lastPosition) > 1 then
				lastPosition = root.Position
				lastProgress = os.clock()
			elseif os.clock() - lastProgress > 1.5 then
				pathCache.blocked = true
				break
			end
		end

		task.wait()
	end

	if pathCache.index > #waypoints then
		clearPathCache()
	end
end

-- Warns in the console if the character hasn't moved for a few seconds while trying to walk
local stallTracker = { position = nil, time = 0 }

local function checkStalled(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then
		return
	end

	if not stallTracker.position or flatDistance(root.Position, stallTracker.position) > 1 then
		stallTracker.position = root.Position
		stallTracker.time = os.clock()
		return
	end

	if os.clock() - stallTracker.time > 3 then
		warn(string.format(
			"[Autofarm] Not moving for 3s. WalkSpeed=%s PlatformStand=%s Sit=%s State=%s Velocity=%.2f Path=%s",
			tostring(hum.WalkSpeed), tostring(hum.PlatformStand), tostring(hum.Sit), tostring(hum:GetState()),
			root.AssemblyLinearVelocity.Magnitude, state.lastPath
		))
		stallTracker.time = os.clock()
	end
end

-- Keeps pathfinding toward an instance until within reach, stopped, or timed out
local function goTo(target, reach, shouldStop, timeout)
	local startTime = os.clock()
	local _, _, startRoot = getCharacter()
	local progressPosition = startRoot and startRoot.Position or Vector3.zero
	local progressTime = os.clock()

	while state.running and not shouldStop() and os.clock() - startTime < timeout do
		local char, _, root = getCharacter()
		if not char or not target.Parent then
			releaseMoveKeys()
			clearPathCache()
			return false
		end

		local position = getPosition(target)
		if not position then
			releaseMoveKeys()
			clearPathCache()
			return false
		end

		if flatDistance(root.Position, position) <= reach then
			releaseMoveKeys()
			clearPathCache()
			return true
		end

		local goal = groundPoint(position, { char, target })
		followPath(goal, char, shouldStop, reach)
		checkStalled(char)


		-- Give up if the character hasn't actually moved for a while, so the caller can try something else
		if flatDistance(root.Position, progressPosition) > 1 then
			progressPosition = root.Position
			progressTime = os.clock()
		elseif os.clock() - progressTime > 4 then
			releaseMoveKeys()
			clearPathCache()
			return false
		end
	end

	releaseMoveKeys()
	clearPathCache()
	return false
end

local function stopAlways()
	return not state.running
end

-- Same as findTargetAnimal but refreshed at most every 0.25s, so per-frame checks stay cheap
local targetCache = { animal = nil, time = 0 }

local function findTargetAnimalCached()
	if os.clock() - targetCache.time > 0.25 then
		targetCache.animal = findTargetAnimal()
		targetCache.time = os.clock()
	end
	return targetCache.animal
end

-- Stop walking when we are free to grab a dropped/caught animal
local function stopForSteal()
	return not state.running or (not isCarrying() and findTargetAnimalCached() ~= nil)
end

----------------------------------------------------------------------
-- Gem drops
----------------------------------------------------------------------

-- Breaking an egg can drop gems into workspace.EggGemDrops. They are picked up
-- by proximity, so collecting one is just walking over it and waiting for the
-- instance to disappear.
local function getGemFolder()
	return Workspace:FindFirstChild("EggGemDrops")
end

-- Attempts per gem, so one drop that pathfinding cannot reach (inside geometry,
-- across a gap) cannot stall the farm by being retried forever.
local gemFailures = {}

local function pruneGemFailures()
	for gem in pairs(gemFailures) do
		if not gem.Parent then
			gemFailures[gem] = nil
		end
	end
end

local function listGems(fromPosition, radius)
	local folder = getGemFolder()
	if not folder then return {} end

	pruneGemFailures()

	local gems = {}
	for _, gem in ipairs(folder:GetChildren()) do
		if (gemFailures[gem] or 0) < CONFIG.GemMaxAttempts then
			local position = getPosition(gem)
			if position then
				local distance = flatDistance(fromPosition, position)
				if distance <= radius then
					gems[#gems + 1] = { gem = gem, distance = distance }
				end
			end
		end
	end

	table.sort(gems, function(a, b) return a.distance < b.distance end)
	return gems
end

-- Give up on gems the moment something worth more needs attention: an animal
-- waiting to be grabbed, or one already in our hands that needs delivering.
local function stopForGems()
	return not state.running or isCarrying() or findTargetAnimalCached() ~= nil
end

-- Walks over every gem within radius. Returns true if at least one was picked
-- up, so the caller can loop again rather than going straight back to eggs.
-- force bypasses the toggle, for the manual "Collect Gems Now" button.
local function collectGems(radius, force)
	if not state.gems and not force then return false end

	local _, _, root = getCharacter()
	if not root then return false end

	local gems = listGems(root.Position, radius or CONFIG.GemRadius)
	if #gems == 0 then return false end

	local collected = 0

	for index, entry in ipairs(gems) do
		if stopForGems() then break end

		local gem = entry.gem

		-- Another pass, or simply standing close enough, may already have
		-- claimed it.
		if gem.Parent then
			setStatus(string.format("Collecting gem %d/%d", index, #gems))

			local reached = goTo(gem, CONFIG.GemReach, stopForGems, CONFIG.GemTimeout)

			-- Pickup is not instant, so allow a moment after arriving.
			if gem.Parent and reached then
				local deadline = os.clock() + CONFIG.GemPickupWait
				while gem.Parent and os.clock() < deadline and state.running do
					task.wait(CONFIG.PollRate)
				end
			end

			if not gem.Parent then
				collected = collected + 1
				gemFailures[gem] = nil
			else
				gemFailures[gem] = (gemFailures[gem] or 0) + 1
			end
		else
			collected = collected + 1
		end
	end

	return collected > 0
end

----------------------------------------------------------------------
-- Tools and auto swing
----------------------------------------------------------------------

-- Presses the 1 key to equip hotbar slot 1 (the pickaxe). Only when nothing is held,
-- since pressing the same slot again would unequip it.
-- Slot 1 holds the pickaxe, but after delivering an animal the ANIMAL is the
-- held Tool: it leaves workspace.CarriedAnimals and goes into the player's
-- hand. So "is any Tool held?" is not the question - it has to be "is the
-- PICKAXE held?", or the script keeps swinging the animal and never mines.
--
-- The pickaxe's name is learned the first time we equip from empty hands, since
-- whatever appears then is slot 1 by definition. Until that happens we fall
-- back to a name heuristic.
local function isPickaxe(tool)
	if not tool then
		return false
	end
	if state.pickaxeName then
		return tool.Name == state.pickaxeName
	end
	local name = tool.Name:lower()
	return name:find("pick") ~= nil or name:find("axe") ~= nil
end

local function findPickaxeInBackpack()
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if not backpack then
		return nil
	end
	for _, tool in ipairs(backpack:GetChildren()) do
		if tool:IsA("Tool") and isPickaxe(tool) then
			return tool
		end
	end
	return nil
end

local function ensurePickaxe(char, hum)
	local heldBefore = char:FindFirstChildOfClass("Tool")

	if isPickaxe(heldBefore) then
		return true
	end

	if os.clock() - state.lastEquipPress < 1 then
		return false
	end
	state.lastEquipPress = os.clock()

	-- Pressing slot 1 while holding a DIFFERENT tool switches to the pickaxe.
	-- The isPickaxe check above is what keeps us from pressing 1 while already
	-- holding it, which would unequip instead.
	local ok = pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
		task.wait(0.05)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
	end)

	task.wait(0.15)
	local heldAfter = char:FindFirstChildOfClass("Tool")

	-- Only learn the name on an empty-hands -> tool transition. Learning after
	-- a failed switch would record the animal's name as the pickaxe.
	if heldAfter and not heldBefore and not state.pickaxeName then
		state.pickaxeName = heldAfter.Name
	end

	if isPickaxe(heldAfter) then
		return true
	end

	-- Key press did not take: equip it directly. Deliberately only a tool that
	-- looks like the pickaxe, never just the first Tool in the backpack, which
	-- could be the animal we are trying to put away.
	local tool = findPickaxeInBackpack()
	if tool and hum then
		pcall(function() hum:EquipTool(tool) end)
		task.wait(0.15)
		return isPickaxe(char:FindFirstChildOfClass("Tool"))
	end

	return false
end

-- AutoSwingColorAlpha: 0 = off, 1 = on
local function isAutoSwingOn(alpha)
	return alpha.Value >= 0.5
end

-- Real mouse click at the button's centre, for when signals don't trigger its handler
local function virtualClick(button)
	local inset = GuiService:GetGuiInset()
	local position = button.AbsolutePosition + button.AbsoluteSize / 2 + inset
	VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, true, game, 0)
	task.wait(0.05)
	VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 0)
end

-- Clicks the AutoSwing button until AutoSwingColorAlpha matches `on`.
-- Each method gets time to take effect before the next one is tried, so the button never gets toggled twice.
local function setAutoSwing(on)
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	local mainGui = playerGui and playerGui:FindFirstChild("MainGUI")
	local button = mainGui and mainGui:FindFirstChild("AutoSwing")
	local alpha = button and button:FindFirstChild("AutoSwingColorAlpha")

	if not button or not alpha then
		notify("Auto Swing", "Could not find AutoSwing.AutoSwingColorAlpha")
		return
	end

	local methods = {
		function() firesignal(button.MouseButton1Click) end,
		function() firesignal(button.Activated) end,
		function() virtualClick(button) end,
	}

	for _, method in ipairs(methods) do
		if isAutoSwingOn(alpha) == on then
			return
		end

		pcall(method)

		local startTime = os.clock()
		while isAutoSwingOn(alpha) ~= on and os.clock() - startTime < 1.5 do
			task.wait(0.1)
		end
	end

	if isAutoSwingOn(alpha) ~= on then
		notify("Auto Swing", "Could not change AutoSwing, none of the click methods worked")
	end
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------

local function stealAnimal(animal)
	local animalPosition = getPosition(animal)
	local prompt = animalPosition and findClosestStealPrompt(animalPosition)
	if not prompt then
		notify("Steal", "No steal prompt found near the animal")
		task.wait(1)
		return
	end

	local arrived = goTo(animal, CONFIG.StealReach, stopAlways, CONFIG.PathGoalTimeout)
	if not arrived or not state.running then
		state.stealAttempts[animal] = (state.stealAttempts[animal] or 0) + 1
		return
	end

	firePrompt(prompt)

	-- Continue as soon as the animal shows up in CarriedAnimals instead of waiting the full time
	local startTime = os.clock()
	while not isCarrying() and os.clock() - startTime < CONFIG.StealWaitTime do
		task.wait(CONFIG.PollRate)
	end

	if isCarrying() then
		notify("Steal", "Picked up " .. animal.Name)
	else
		state.stealAttempts[animal] = (state.stealAttempts[animal] or 0) + 1
	end
end

local function breakEgg(egg)
	if isEggBroken(egg) then
		return
	end

	local startTime = os.clock()

	while state.running and egg.Parent and not isEggBroken(egg) do
		if stopForSteal() or os.clock() - startTime > CONFIG.EggTimeout then
			return
		end

		local char, hum, root = getCharacter()
		if not char then
			return
		end

		ensurePickaxe(char, hum)

		local eggPosition = getPosition(egg)
		if not eggPosition then
			return
		end

		if flatDistance(root.Position, eggPosition) > CONFIG.EggReach then
			goTo(egg, CONFIG.EggReach, stopForSteal, CONFIG.PathGoalTimeout)
		else
			task.wait(CONFIG.PollRate)
		end
	end
end

-- Closest selected egg that isn't broken yet, measured from the player
local function findNearestSelectedEgg(eggsFolder)
	local _, _, root = getCharacter()
	if not root then
		return nil
	end

	local best, bestDistance = nil, math.huge
	for _, egg in ipairs(eggsFolder:GetChildren()) do
		local position = getPosition(egg)
		if state.selectedEggs[egg.Name] and position and not isEggBroken(egg) then
			local distance = flatDistance(root.Position, position)
			if distance < bestDistance then
				best, bestDistance = egg, distance
			end
		end
	end
	return best
end

local function farmZone()
	local zone = state.zone
	local eggsFolder = getZoneEggsFolder(zone)
	local zoneEggs = eggsFolder and eggsFolder:GetChildren() or {}

	-- Far zones may not have their eggs loaded yet, so walk to the zone building and wait for them
	if #zoneEggs == 0 then
		local hitbox = getZoneHitbox(zone)
		local zoneTarget
		if hitbox then
			zoneTarget = (hitbox:IsA("Model") or hitbox:IsA("BasePart")) and hitbox
				or hitbox:FindFirstChildWhichIsA("BasePart", true)
		end

		if not zoneTarget then
			setStatus("Waiting for " .. zone.Name .. " to load")
			task.wait(1)
			return
		end

		setStatus("Going to " .. zone.Name)
		goTo(zoneTarget, CONFIG.ZoneReach, stopForSteal, CONFIG.PathGoalTimeout)

		setStatus("Waiting for " .. zone.Name .. " eggs to load")
		while state.running and not stopForSteal() do
			eggsFolder = getZoneEggsFolder(zone)
			if eggsFolder and #eggsFolder:GetChildren() > 0 then
				break
			end
			task.wait(0.5)
		end
		return
	end

	-- Walk into the zone first if we're not already near its eggs
	local _, _, root = getCharacter()
	local inZone = false
	if root then
		for _, egg in ipairs(zoneEggs) do
			local position = getPosition(egg)
			if position and flatDistance(root.Position, position) < 80 then
				inZone = true
				break
			end
		end
	end
	if not inZone then
		goTo(zoneEggs[1], CONFIG.ZoneReach, stopForSteal, CONFIG.PathGoalTimeout)
		return
	end

	-- Break the closest selected egg each time until none are left
	while state.running and not stopForSteal() do
		local egg = findNearestSelectedEgg(eggsFolder)
		if not egg then
			break
		end
		breakEgg(egg)

		-- Gems land where the egg broke, so sweep the immediate area before
		-- walking off to the next one.
		collectGems(CONFIG.GemRadius)
	end

	if next(state.selectedEggs) == nil then
		task.wait(1)
	end
end

local function deliverAnimal()
	setStatus("Running animal back to base")
	local arrived = goTo(state.spawnPart, CONFIG.HomeReach, stopForSteal, CONFIG.PathGoalTimeout)
	if not arrived and state.running and isCarrying() then
		setStatus("Base route failed, retrying")
	end

	if arrived then
		-- Wait for the animal to be secured at base, then bring the pickaxe back out
		local startTime = os.clock()
		while state.running and isCarrying() and os.clock() - startTime < 5 do
			task.wait(CONFIG.PollRate)
		end

		-- The animal ends up in the player's hand rather than back in
		-- CarriedAnimals, so swapping to slot 1 is what actually puts it away
		-- and gets the pickaxe back out. One key press can be dropped, so keep
		-- trying until the pickaxe is genuinely held.
		setStatus("Re-equipping pickaxe")

		for _ = 1, 8 do
			if not state.running then
				break
			end

			local char, hum = getCharacter()
			if not char then
				break
			end

			state.lastEquipPress = 0
			if ensurePickaxe(char, hum) then
				break
			end

			task.wait(0.25)
		end

		local char = getCharacter()
		if char and state.running and not isPickaxe(char:FindFirstChildOfClass("Tool")) then
			setStatus("Could not re-equip pickaxe, retrying next cycle")
		end
	end

	task.wait(0.5)
end

local function mainLoop()
	while state.running do
		local char = getCharacter()
		if not char then
			setStatus("Waiting for character")
			task.wait(1)
			continue
		end

		if isCarrying() then
			deliverAnimal()
		else
			local target = findTargetAnimal()
			if target then
				setStatus("Stealing " .. target.Name)
				stealAnimal(target)
			elseif collectGems(CONFIG.GemRadius) then
				-- Picked something up; re-evaluate before returning to eggs.
			else
				setStatus("Farming eggs")
				farmZone()
			end
		end

		task.wait(CONFIG.PollRate)
	end
end

-- Keeps the camera fixed behind the character, facing the direction it had when farming started.
-- W/A/S/D are camera-relative, so a fixed camera keeps the steering correct.
local cameraLock

local function startCameraLock()
	local camera = Workspace.CurrentCamera
	local look = camera.CFrame.LookVector
	local forward = Vector3.new(look.X, 0, look.Z)
	if forward.Magnitude < 0.01 then
		forward = Vector3.new(0, 0, -1)
	end
	forward = forward.Unit

	camera.CameraType = Enum.CameraType.Scriptable
	cameraLock = RunService.RenderStepped:Connect(function()
		local _, _, root = getCharacter()
		if not root then
			return
		end
		local focus = root.Position + Vector3.new(0, 2, 0)
		camera.CFrame = CFrame.lookAt(focus - forward * 12, focus)
	end)
end

local function stopCameraLock()
	if cameraLock then
		cameraLock:Disconnect()
		cameraLock = nil
	end
	Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
end

local function stopFarm()
	if not state.running then
		return
	end
	state.running = false
	stopCameraLock()
	setAutoSwing(false)
	notify("Autofarm", "Stopped")
end

local function startFarm()
	if state.running then
		return
	end

	-- When auto-executed the base may not be loaded yet, so give it time before giving up
	local spawnPart
	local waitStart = os.clock()
	repeat
		local plot = findMyPlot()
		spawnPart = plot and plot:FindFirstChild("SpawnPoint")
		if not spawnPart then
			task.wait(1)
		end
	until spawnPart or os.clock() - waitStart > 30

	if not spawnPart then
		notify("Autofarm", "Could not find your base SpawnPoint")
		pcall(function()
			farmToggle:Set(false)
		end)
		return
	end

	state.spawnPart = spawnPart
	state.stealAttempts = {}

	-- Learn slot 1's tool name now, while the player is almost certainly
	-- holding the pickaxe and not an animal. Without this, isPickaxe falls back
	-- to a name heuristic, and a pickaxe whose name lacks "pick"/"axe" would be
	-- misread as the wrong tool - pressing 1 would then unequip it.
	if not state.pickaxeName and not isCarrying() then
		local char = getCharacter()
		local held = char and char:FindFirstChildOfClass("Tool")
		if held then
			state.pickaxeName = held.Name
			print("[Autofarm] Pickaxe identified as:", held.Name)
		end
	end

	state.running = true
	startCameraLock()
	notify("Autofarm", "Started")

	task.spawn(function()
		local ok, err = pcall(function()
			setAutoSwing(true)
			mainLoop()
		end)
		if not ok then
			warn("[Autofarm] " .. tostring(err))
			notify("Autofarm error", tostring(err))
			stopFarm()
			pcall(function()
				farmToggle:Set(false)
			end)
		end
	end)
end

-- Rayfield's Refresh replaces the option list but leaves CurrentOption alone,
-- so the previous zone's ticks stay on screen even though state.selectedEggs
-- has been cleared. Clearing the selection explicitly is what actually makes
-- the dropdown look refreshed.
local function refreshDropdown(dropdown, options, clearSelection)
	if not dropdown then return false end

	local ok, err = pcall(function()
		if type(dropdown.Refresh) == "function" then
			dropdown:Refresh(options)
		end
	end)

	if not ok then
		warn("[Autofarm] dropdown refresh failed:", err)
	end

	if clearSelection then
		-- Separate pcall: a failure here must not hide a successful Refresh.
		pcall(function() dropdown:Set({}) end)
	end

	return ok
end

local function setZone(zone)
	if not zone then return end

	state.zone = zone
	state.selectedEggs = {}

	local names = getEggNames(zone)

	-- With ConfigurationSaving on, Rayfield fires this callback while restoring
	-- the saved zone, which can happen before the Eggs dropdown exists. Nothing
	-- to refresh yet; it gets built from state.zone immediately after.
	if not eggDropdown then return end

	refreshDropdown(eggDropdown, names, true)

	if #names == 0 then
		setStatus(string.format("%s: no eggs found (%s)", zone.Name,
			zone.EggFolder
				and ("folder '" .. zone.EggFolder .. "' is empty or missing")
				or "egg folder unmapped, try Rescan Zones"))
	end
end

-- Re-runs discovery and pushes any newly found zone into the dropdown. Safe to
-- call repeatedly: rebuildZones reports whether anything actually changed, and
-- the current selection is carried across by zone number.
local function refreshZones()
	if not rebuildZones() then return false end

	local keepNumber = state.zone and state.zone.Number
	local keep = nil
	for _, zone in ipairs(ZONES) do
		if zone.Number == keepNumber then
			keep = zone
			break
		end
	end
	local sameZone = keep ~= nil and keep.Number == keepNumber
	keep = keep or ZONES[1]

	-- Preserve the egg selection across a rebuild of the same zone. Calling
	-- Set() on the zone dropdown fires its callback, which runs setZone and
	-- wipes selectedEggs - unwanted when a background rescan merely refreshed
	-- the list the player is already on.
	local keptSelection = sameZone and state.selectedEggs or nil

	refreshDropdown(zoneDropdown, zoneNames, false)

	-- Re-point at the rebuilt entry; the old table has been discarded.
	state.zone = keep

	if zoneDropdown and not sameZone then
		-- The selected zone genuinely went away, so move the UI to the
		-- fallback and let the callback reset the egg list.
		pcall(function() zoneDropdown:Set({ keep.Name }) end)
	else
		-- Same zone: refresh the egg options in place and put the selection back.
		refreshDropdown(eggDropdown, getEggNames(keep), false)
		if keptSelection then
			state.selectedEggs = keptSelection
		end
	end

	return true
end

----------------------------------------------------------------------
-- Config saving
----------------------------------------------------------------------

local CONFIG_FILE = "EggAutofarm_config.json"

local function canUseFiles()
	return typeof(writefile) == "function"
		and typeof(readfile) == "function"
		and typeof(isfile) == "function"
end

local function collectConfig()
	local eggs = {}
	for name in pairs(state.selectedEggs) do
		eggs[#eggs + 1] = name
	end
	table.sort(eggs)

	return {
		version      = 1,
		zoneNumber   = state.zone and state.zone.Number or nil,
		selectedEggs = eggs,
		minCpsText   = state.minCpsText,
		minCps       = state.minCps,
		gems         = state.gems,
		gemRadius    = CONFIG.GemRadius,
		pickaxeName  = state.pickaxeName,
		autofarm     = state.running,
	}
end

local function saveConfig()
	if not canUseFiles() then
		return false, "executor has no file access"
	end

	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(collectConfig())
	end)
	if not ok then
		return false, tostring(encoded)
	end

	local wrote, err = pcall(function()
		writefile(CONFIG_FILE, encoded)
	end)
	if not wrote then
		return false, tostring(err)
	end

	return true
end

local function loadConfig()
	if not canUseFiles() then
		return nil
	end

	local exists = false
	pcall(function()
		exists = isfile(CONFIG_FILE)
	end)
	if not exists then
		return nil
	end

	local ok, raw = pcall(readfile, CONFIG_FILE)
	if not ok or type(raw) ~= "string" or raw == "" then
		return nil
	end

	local decoded
	ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(decoded) ~= "table" then
		return nil
	end

	return decoded
end

-- Every control calls queueSave, and applyConfig drives those same controls via
-- Set(), which fires their callbacks. Without this guard a load would save
-- itself back halfway through, writing a partially applied config.
local applyingConfig = false
local savePending = false

-- Debounced: dragging a slider fires its callback many times a second, and
-- writing a file on each one is both wasteful and a good way to catch a
-- half-written file on the next load.
local function queueSave()
	if applyingConfig or savePending then
		return
	end
	savePending = true

	task.spawn(function()
		task.wait(0.5)
		savePending = false
		local ok, err = saveConfig()
		if not ok then
			warn("[Autofarm] Config autosave failed:", err)
		end
	end)
end

-- Order matters here. Setting the zone clears the egg selection, so the zone
-- has to be applied first and the eggs restored afterwards. This is exactly
-- what Rayfield's own restore could not guarantee.
local function applyConfig(cfg)
	if type(cfg) ~= "table" then
		return false
	end

	applyingConfig = true

	-- 1. Simple scalars.
	if type(cfg.gemRadius) == "number" then
		CONFIG.GemRadius = cfg.gemRadius
		pcall(function() gemRadiusSlider:Set(cfg.gemRadius) end)
	end

	if type(cfg.gems) == "boolean" then
		state.gems = cfg.gems
		pcall(function() gemsToggle:Set(cfg.gems) end)
	end

	if type(cfg.pickaxeName) == "string" and cfg.pickaxeName ~= "" then
		state.pickaxeName = cfg.pickaxeName
	end

	-- 2. Zone, which resets the egg list and selection.
	if type(cfg.zoneNumber) == "number" then
		for _, zone in ipairs(ZONES) do
			if zone.Number == cfg.zoneNumber then
				setZone(zone)
				pcall(function() zoneDropdown:Set({ zone.Name }) end)
				break
			end
		end
	end

	-- 3. Eggs, after the zone has repopulated the options. Only restore eggs
	-- that still exist in this zone, so a removed egg cannot linger.
	if type(cfg.selectedEggs) == "table" then
		local available = {}
		for _, name in ipairs(getEggNames(state.zone)) do
			available[name] = true
		end

		local restored, selected = {}, {}
		for _, name in ipairs(cfg.selectedEggs) do
			if available[name] then
				restored[#restored + 1] = name
				selected[name] = true
			end
		end

		if #restored > 0 then
			state.selectedEggs = selected
			pcall(function() eggDropdown:Set(restored) end)
		end
	end

	-- 4. Threshold. Re-parse the text so the saved number and its display
	-- cannot drift apart.
	if type(cfg.minCpsText) == "string" and cfg.minCpsText ~= "" then
		local value = parseMoney(cfg.minCpsText)
		if value then
			state.minCps = value
			state.minCpsText = cfg.minCpsText
			pcall(function() minCpsInput:Set(cfg.minCpsText) end)
		end
	elseif type(cfg.minCps) == "number" then
		state.minCps = cfg.minCps
	end

	applyingConfig = false

	-- 5. Autofarm last, so it only ever starts once the zone, eggs and
	-- threshold it depends on are already in place. Spawned rather than called
	-- inline because startFarm waits up to 30s for the base to load, which
	-- would otherwise block whoever asked for the config to be applied.
	if cfg.autofarm == true and not state.running then
		task.spawn(function()
			pcall(function() farmToggle:Set(true) end)
		end)
	end

	return true
end

----------------------------------------------------------------------
-- Rayfield UI
----------------------------------------------------------------------

-- Prints each hatched animal's raw cash/s text and the value the script reads from it
local function printAnimalValues()
	print("[Autofarm] Threshold (parsed):", state.minCps)

	local pickups = Workspace:FindFirstChild("AnimalPickups")
	if not pickups then
		print("[Autofarm] No AnimalPickups folder found")
		notify("Animal values", "No AnimalPickups folder found")
		return
	end

	for _, animal in ipairs(pickups:GetChildren()) do
		local label = findChildPath(animal, {
			"RootPart", "AnimalOverheadAttachment", "AnimalOverhead", "CashPerSecond", "CashPerSecond",
		})
		local rawText = label and label:IsA("TextLabel") and label.Text or "LABEL NOT FOUND"
		print("[Autofarm]", animal.Name, "text:", rawText, "value:", readCashPerSecond(animal) or "nil")
	end

	notify("Animal values", "Printed to the console (F9)")
end

-- Prints the values that could control movement speed, so the real in-game speed source can be found
local function printSpeedInfo()
	local char, hum, root = getCharacter()
	if not char then
		notify("Speed info", "No character found")
		return
	end

	-- Measure how far the character actually moves over half a second.
	-- Hold W while pressing the button to measure your real walking speed.
	local startPosition = root.Position
	task.wait(0.5)
	local measuredSpeed = flatDistance(root.Position, startPosition) / 0.5

	print("[Autofarm] Humanoid.WalkSpeed:", hum.WalkSpeed)
	print("[Autofarm] Measured flat speed over 0.5s:", measuredSpeed)
	print("[Autofarm] Humanoid.WalkSpeed is default:", hum.WalkSpeed == 16)

	for name, value in pairs(char:GetAttributes()) do
		print("[Autofarm] Character attribute", name, value)
	end
	for name, value in pairs(hum:GetAttributes()) do
		print("[Autofarm] Humanoid attribute", name, value)
	end
	for name, value in pairs(LocalPlayer:GetAttributes()) do
		print("[Autofarm] Player attribute", name, value)
	end

	notify("Speed info", "WalkSpeed " .. tostring(hum.WalkSpeed) .. ", check the console (F9)")
end

local Window = Rayfield:CreateWindow({
	Name = "Egg Autofarm",
	LoadingTitle = "Egg Autofarm",
	LoadingSubtitle = "Loading...",
	-- Rayfield's own saving is off on purpose: restoring the zone clears the
	-- egg selection, and its restore order is dictionary order, so eggs could
	-- be applied before the zone and then wiped. The config below is applied
	-- in a controlled order instead.
	ConfigurationSaving = { Enabled = false },
	Discord = { Enabled = false },
	KeySystem = false,
})

local FarmTab = Window:CreateTab("Autofarm", 4483362458)

statusLabel = FarmTab:CreateLabel("Status: Idle")

zoneDropdown = FarmTab:CreateDropdown({
	Name = "Zone",
	Options = zoneNames,
	CurrentOption = { zoneNames[1] },
	MultipleOptions = false,
	Flag = "ZoneDropdown",
	Callback = function(option)
		local name = type(option) == "table" and option[1] or option
		local zone = zoneByName[name]
		if zone then
			setZone(zone)
			queueSave()
		end
	end,
})

FarmTab:CreateButton({
	Name = "Rescan Zones",
	Callback = function()
		task.spawn(function()
			local changed = refreshZones()
			local parts = {}
			for _, zone in ipairs(ZONES) do
				parts[#parts + 1] = string.format("%s -> %s", zone.Name, zone.EggFolder or "unmapped")
			end
			print("[Autofarm] Zones:\n  " .. table.concat(parts, "\n  "))
			Rayfield:Notify({
				Title = changed and "Zones Updated" or "Zones Unchanged",
				Content = string.format("%d zone(s) found. Mapping printed to console.", #ZONES),
				Duration = 6,
				Image = 4483362458,
			})
		end)
	end,
})

eggDropdown = FarmTab:CreateDropdown({
	Name = "Eggs",
	Options = getEggNames(state.zone),
	CurrentOption = {},
	MultipleOptions = true,
	Flag = "EggDropdown",
	Callback = function(options)
		local selected = {}
		if type(options) == "table" then
			for _, name in ipairs(options) do
				selected[name] = true
			end
		end
		state.selectedEggs = selected
		queueSave()
	end,
})

minCpsInput = FarmTab:CreateInput({
	Name = "Min Cash/s",
	PlaceholderText = "e.g. 20T",
	RemoveTextAfterFocusLost = false,
	Flag = "MinCashPerSecond",
	Callback = function(text)
		local value = parseMoney(text)
		if value then
			state.minCps = value
			state.minCpsText = text
			queueSave()
			print("[Autofarm] Threshold set to", value, "from input", text)
			notify("Threshold", "Stealing animals above " .. text)
		else
			notify("Threshold", "Could not read that value, use a format like 20T or 1.5B")
		end
	end,
})

farmToggle = FarmTab:CreateToggle({
	Name = "Autofarm",
	CurrentValue = false,
	Flag = "AutofarmToggle",
	Callback = function(value)
		if value then
			startFarm()
		else
			stopFarm()
		end
		queueSave()
	end,
})

FarmTab:CreateButton({
	Name = "Print speed info",
	Callback = printSpeedInfo,
})

FarmTab:CreateButton({
	Name = "Print animal values",
	Callback = printAnimalValues,
})

gemsToggle = FarmTab:CreateToggle({
	Name = "Auto Collect Gems",
	CurrentValue = true,
	Flag = "AutoCollectGems",
	Callback = function(value)
		state.gems = value
		queueSave()
	end,
})

gemRadiusSlider = FarmTab:CreateSlider({
	Name = "Gem Search Radius",
	Range = { 25, 600 },
	Increment = 25,
	Suffix = " studs",
	CurrentValue = CONFIG.GemRadius,
	Flag = "GemRadius",
	Callback = function(value)
		CONFIG.GemRadius = value
		queueSave()
	end,
})

FarmTab:CreateButton({
	Name = "Collect Gems Now",
	Callback = function()
		task.spawn(function()
			local folder = getGemFolder()
			if not folder then
				notify("Gems", "workspace.EggGemDrops not found")
				return
			end

			local total = #folder:GetChildren()
			if total == 0 then
				notify("Gems", "No gems on the ground")
				return
			end

			-- The manual button should work with the farm stopped, and
			-- collectGems needs state.running to drive goTo.
			local wasRunning = state.running
			state.running = true

			local picked = collectGems(CONFIG.GemRadius, true)

			state.running = wasRunning
			notify("Gems", picked and ("Swept " .. total .. " gem(s)") or "Nothing in range")
		end)
	end,
})

FarmTab:CreateButton({
	Name = "Save Config",
	Callback = function()
		local ok, err = saveConfig()
		if ok then
			local eggCount = 0
			for _ in pairs(state.selectedEggs) do
				eggCount = eggCount + 1
			end
			notify("Config Saved", string.format("%s, %d egg(s), threshold %s",
				state.zone and state.zone.Name or "no zone",
				eggCount,
				state.minCpsText or tostring(state.minCps)))
		else
			notify("Config", "Save failed: " .. tostring(err))
		end
	end,
})

FarmTab:CreateButton({
	Name = "Load Config",
	Callback = function()
		local cfg = loadConfig()
		if cfg and applyConfig(cfg) then
			notify("Config", "Loaded saved settings")
		else
			notify("Config", "No saved config found")
		end
	end,
})

----------------------------------------------------------------------
-- Startup
----------------------------------------------------------------------

-- Auto-load on execute. Runs after every control exists, so applyConfig can
-- drive the UI as well as the state.
task.spawn(function()
	local cfg = loadConfig()
	if not cfg then
		return
	end

	-- Zone discovery can still be waiting on workspace.Build, and a config
	-- naming a zone we have not found yet would silently not apply.
	for _ = 1, 10 do
		local found = false
		for _, zone in ipairs(ZONES) do
			if zone.Number == cfg.zoneNumber then
				found = true
				break
			end
		end
		if found or cfg.zoneNumber == nil then
			break
		end
		task.wait(1)
	end

	if applyConfig(cfg) then
		print("[Autofarm] Config loaded from " .. CONFIG_FILE)
		setStatus("Config loaded")
	end
end)

----------------------------------------------------------------------
-- Zone auto-discovery
----------------------------------------------------------------------

-- workspace.Build can finish replicating after the UI is built, and a zone may
-- be added by a live update, so rescan on a slow timer. refreshZones is a no-op
-- unless the discovered list actually differs, which keeps this invisible.
task.spawn(function()
	-- Catch late replication quickly, then settle into a slow poll.
	for _ = 1, 10 do
		task.wait(2)
		if refreshZones() then break end
	end

	while true do
		task.wait(60)
		pcall(refreshZones)
	end
end)
