local HookTab = Window:CreateTab("Webhook", "bell")

HookTab:CreateSection("Discord")

local webhookStatus = HookTab:CreateParagraph({
	Title = "Status",
	Content = webhookAvailable()
		and "Executor supports HTTP requests. Paste a webhook URL to begin."
		or "This executor has no HTTP request function, so webhooks cannot be sent.",
})

HookTab:CreateInput({
	Name = "Webhook URL",
	CurrentValue = "",
	PlaceholderText = "https://discord.com/api/webhooks/...",
	RemoveTextAfterFocusLost = false,
	Flag = "WebhookUrl",
	Callback = function(text)
		text = tostring(text or ""):gsub("%s", "")

		if text == "" then
			state.webhookUrl = nil
		elseif text:match("^https://discord%.com/api/webhooks/") then
			state.webhookUrl = text
			notify("Webhook", "URL saved")
		else
			state.webhookUrl = nil
			notify("Webhook", "That is not a Discord webhook URL")
		end

		queueSave()
	end,
})

HookTab:CreateToggle({
	Name = "Send notifications",
	CurrentValue = false,
	Flag = "WebhookEnabled",
	Callback = function(value)
		if value and not webhookAvailable() then
			notify("Webhook", "Executor has no HTTP request function")
			return
		end
		if value and not state.webhookUrl then
			notify("Webhook", "Set a webhook URL first")
			return
		end
		state.webhookEnabled = value
		queueSave()
	end,
})

HookTab:CreateInput({
	Name = "Only notify above",
	CurrentValue = "",
	PlaceholderText = "e.g. 100T (blank = every steal)",
	RemoveTextAfterFocusLost = false,
	Flag = "WebhookMinValue",
	Callback = function(text)
		if tostring(text or ""):gsub("%s", "") == "" then
			state.webhookMinValue = 0
			queueSave()
			return
		end

		local value = parseMoney(text)
		if value then
			state.webhookMinValue = value
			notify("Webhook", "Only animals above " .. text)
		else
			notify("Webhook", "Could not read that value")
		end
		queueSave()
	end,
})

HookTab:CreateDivider()

HookTab:CreateButton({
	Name = "Send test message",
	Callback = function()
		task.spawn(function()
			if not state.webhookUrl then
				notify("Webhook", "Set a webhook URL first")
				return
			end

			-- Bypass the enabled flag and the queue so the result is immediate
			-- and the exact failure reason can be surfaced.
			local ok, err = postWebhook(baseEmbed("Webhook connected", 3447003, {
				{ name = "Player", value = LocalPlayer.Name, inline = true },
				{ name = "Zone", value = state.zone and state.zone.Name or "unknown", inline = true },
			}))

			notify("Webhook", ok and "Test message sent" or ("Failed: " .. tostring(err)))
			pcall(function()
				webhookStatus:Set({
					Title = "Status",
					Content = ok and "Last test succeeded." or ("Last test failed: " .. tostring(err)),
				})
			end)
		end)
	end,
})

HookTab:CreateButton({
	Name = "Send session report now",
	Callback = function()
		if not state.webhookEnabled then
			notify("Webhook", "Notifications are off")
			return
		end
		sendSessionReport("Session report")
		notify("Webhook", "Report queued")
	end,
})

