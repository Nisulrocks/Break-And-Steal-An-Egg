-- Egg autofarm with Rayfield UI
-- Loop: go to zone -> break selected eggs -> steal good animals -> run them home -> repeat

local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

local CONFIG = {
	PollRate = 0.1,
	WaypointTimeout = 3,
	WaypointReach = 4,
	PathGoalTimeout = 40,
	EggReach = 1.5,
	EggTimeout = 120,
	ZoneReach = 25,
	StealReach = 5,
	StealWaitTime = 1.5,
	HomeReach = 6,
	MaxStealAttempts = 5,
	GemReach = 3,
	GemTimeout = 12,
	GemRadius = 250,
	GemMaxAttempts = 2,
	GemPickupWait = 0.6,
}

local PATH_PARAMS = {
	AgentRadius = 3,
	AgentHeight = 5,
	AgentCanJump = true,
	AgentCanClimb = false,
	-- 12 was coarse enough that the straight line between two waypoints could
	-- pass through a wall corner the navmesh had routed around.
	WaypointSpacing = 4,
}

local SUFFIXES = {
	k = 1e3, m = 1e6, b = 1e9, t = 1e12,
	qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24,
	oc = 1e27, no = 1e30, dc = 1e33,
	ud = 1e36, dd = 1e39, td = 1e42, qd = 1e45,
}

-- Zone build folder is workspace.Build.ZoneBuilds[Build]
-- Egg folder is ReplicatedStorage.Eggs.NormalEggs[EggFolder]
--
-- Zones are DISCOVERED from workspace.Build at runtime rather than hardcoded,
-- so a zone added by a game update shows up without editing this script.
--
-- The table below is only a hint. The zone-number -> egg-folder mapping is
-- arbitrary (Zone 1 uses "Forest Eggs", Zone 12 uses "FairyEgg", Zone 13 uses
-- "FantasyExpansion"), so there is no pattern to derive it from; known pairs
-- are seeded here and anything new is resolved by resolveEggFolder below.
local EGG_FOLDER_HINTS = {
	[1]  = "Forest Eggs",
	[2]  = "Desert Eggs",
	[3]  = "Snowy Eggs",
	[4]  = "Candy Eggs",
	[5]  = "Lake Eggs",
	[6]  = "Under Water Eggs",
	[7]  = "Volcano Eggs",
	[8]  = "Blossom Eggs",
	[9]  = "Galaxy Eggs",
	[10] = "Alien Eggs",
	[11] = "Zone_11",
	[12] = "FairyEgg",
	[13] = "FantasyExpansion",
}

-- These three are mutated in place, never reassigned: the Rayfield dropdown
-- holds a reference to zoneNames, so swapping the table would leave the UI
-- pointing at a stale copy.
local ZONES = {}
local zoneNames = {}
local zoneByName = {}

local function getBuildFolder()
	return Workspace:FindFirstChild("Build")
end

local function getNormalEggsFolder()
	local eggs = ReplicatedStorage:FindFirstChild("Eggs")
	return eggs and eggs:FindFirstChild("NormalEggs")
end

-- Zone numbers come from ZoneHitboxes (named "1".."14", and present even while
-- the zone build itself is streamed out) unioned with ZoneBuilds ("Zone1"...).
local function discoverZoneNumbers()
	local seen, numbers = {}, {}

	local build = getBuildFolder()
	if not build then return numbers end

	local function note(raw)
		local n = tonumber(raw)
		if n and not seen[n] then
			seen[n] = true
			numbers[#numbers + 1] = n
		end
	end

	for _, folderName in ipairs({ "ZoneHitboxes", "ZoneBuilds" }) do
		local folder = build:FindFirstChild(folderName)
		if folder then
			for _, child in ipairs(folder:GetChildren()) do
				note(child.Name:match("%d+"))
			end
		end
	end

	table.sort(numbers)
	return numbers
end

-- Identify a zone's egg folder by content rather than by name: the in-world
-- zone build holds egg instances whose names match the definitions inside
-- exactly one NormalEggs folder. Works for any future naming scheme, but only
-- while that zone is streamed in.
local function matchEggFolderByContents(number, claimed)
	local build = getBuildFolder()
	local builds = build and build:FindFirstChild("ZoneBuilds")
	local zoneBuild = builds and builds:FindFirstChild("Zone" .. number)
	local worldEggs = zoneBuild and zoneBuild:FindFirstChild("Eggs")
	local normal = getNormalEggsFolder()

	if not worldEggs or not normal then return nil end

	local present = {}
	local anyPresent = false
	for _, egg in ipairs(worldEggs:GetChildren()) do
		present[egg.Name] = true
		anyPresent = true
	end
	if not anyPresent then return nil end

	local bestName, bestScore = nil, 0
	for _, folder in ipairs(normal:GetChildren()) do
		if not claimed[folder.Name] then
			local score = 0
			for _, definition in ipairs(folder:GetChildren()) do
				if present[definition.Name] then score = score + 1 end
			end
			if score > bestScore then
				bestName, bestScore = folder.Name, score
			end
		end
	end

	return bestName
end

local function resolveEggFolder(number, claimed)
	local normal = getNormalEggsFolder()
	if not normal then return nil end

	-- 1. A seeded pair we already know is correct.
	local hint = EGG_FOLDER_HINTS[number]
	if hint and not claimed[hint] and normal:FindFirstChild(hint) then
		return hint
	end

	-- 2. The folder is sometimes just named after the zone.
	for _, candidate in ipairs({ "Zone_" .. number, "Zone" .. number, "Zone " .. number }) do
		if not claimed[candidate] and normal:FindFirstChild(candidate) then
			return candidate
		end
	end

	-- 3. Match on the egg names the zone actually contains.
	return matchEggFolderByContents(number, claimed)
end

-- Returns true when the discovered zone list differs from what we had, so
-- callers know whether the UI needs refreshing.
local function rebuildZones()
	local numbers = discoverZoneNumbers()

	-- Build has not replicated yet; keep whatever list we already have.
	if #numbers == 0 then return false end

	local claimed = {}
	local fresh = {}

	for _, number in ipairs(numbers) do
		local entry = {
			Number = number,
			Name   = "Zone " .. number,
			Build  = "Zone" .. number,
		}
		local folder = resolveEggFolder(number, claimed)
		if folder then
			entry.EggFolder = folder
			claimed[folder] = true
		end
		fresh[#fresh + 1] = entry
	end

	-- Anything still unmapped gets paired with a leftover folder. For the usual
	-- shape of an update - one new zone, one new egg folder - this lands the
	-- correct pairing with no extra information.
	local normal = getNormalEggsFolder()
	if normal then
		local leftovers = {}
		for _, folder in ipairs(normal:GetChildren()) do
			if not claimed[folder.Name] then
				leftovers[#leftovers + 1] = folder.Name
			end
		end
		table.sort(leftovers)

		local nextLeftover = 1
		for _, entry in ipairs(fresh) do
			if not entry.EggFolder and leftovers[nextLeftover] then
				entry.EggFolder = leftovers[nextLeftover]
				claimed[leftovers[nextLeftover]] = true
				nextLeftover = nextLeftover + 1
			end
		end
	end

	-- Did anything actually change?
	local changed = (#fresh ~= #ZONES)
	if not changed then
		for i, entry in ipairs(fresh) do
			local old = ZONES[i]
			if not old or old.Number ~= entry.Number or old.EggFolder ~= entry.EggFolder then
				changed = true
				break
			end
		end
	end

	if not changed then return false end

	-- Mutate in place so the UI's reference stays valid.
	for i = #ZONES, 1, -1 do ZONES[i] = nil end
	for i = #zoneNames, 1, -1 do zoneNames[i] = nil end
	for key in pairs(zoneByName) do zoneByName[key] = nil end

	for i, entry in ipairs(fresh) do
		ZONES[i] = entry
		zoneNames[i] = entry.Name
		zoneByName[entry.Name] = entry
	end

	return true
end

rebuildZones()

-- Join can beat replication of workspace.Build, so seed the known zones if
-- discovery came back empty. A later rescan replaces them.
if #ZONES == 0 then
	for number = 1, 13 do
		local entry = {
			Number    = number,
			Name      = "Zone " .. number,
			Build     = "Zone" .. number,
			EggFolder = EGG_FOLDER_HINTS[number],
		}
		ZONES[number] = entry
		zoneNames[number] = entry.Name
		zoneByName[entry.Name] = entry
	end
end

local state = {
	running = false,
	spawnPart = nil,
	minCps = 0,
	zone = ZONES[1],
	selectedEggs = {},
	stealAttempts = {},
	lastEquipPress = 0,
	lastPath = "none",
	gems = true,
	pickaxeName = nil,
	minCpsText = nil,
}

