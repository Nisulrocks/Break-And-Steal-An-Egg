----------------------------------------------------------------------
-- Dashboard refresh
----------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(1)

		pcall(function()
			local elapsed = sessionSeconds()

			sessionParagraph:Set({
				Title = "This session",
				Content = string.format(
					"Runtime: %s\nZone: %s\nAction: %s\n\nEggs broken: %d  (%.0f/hr)\nAnimals stolen: %d  (%.0f/hr)\nDelivered: %d\nGems: %d\n\nValue stolen: %s/s\nBest: %s",
					formatDuration(elapsed),
					state.zone and state.zone.Name or "none",
					state.action or "Idle",
					stats.eggsBroken, perHour(stats.eggsBroken),
					stats.animalsStolen, perHour(stats.animalsStolen),
					stats.delivered,
					stats.gemsCollected,
					formatMoney(stats.valueStolen),
					stats.bestName
						and string.format("%s (%s)", stats.bestName, formatMoney(stats.bestValue))
						or "none yet"),
			})

			lifetimeParagraph:Set({
				Title = "All time",
				Content = string.format(
					"Runtime: %s\nEggs broken: %d\nAnimals stolen: %d\nDelivered: %d\nGems: %d\nBest: %s",
					formatDuration(lifetime.runtime + elapsed),
					lifetime.eggsBroken,
					lifetime.animalsStolen,
					lifetime.delivered,
					lifetime.gemsCollected,
					lifetime.bestName
						and string.format("%s (%s)", lifetime.bestName, formatMoney(lifetime.bestValue))
						or "none yet"),
			})
		end)
	end
end)

----------------------------------------------------------------------
-- Startup
----------------------------------------------------------------------

-- Auto-load on execute. Runs after every control exists, so applyConfig can
-- drive the UI as well as the state.
task.spawn(function()
	local cfg = loadConfig()
	if not cfg then
		return
	end

	-- Zone discovery can still be waiting on workspace.Build, and a config
	-- naming a zone we have not found yet would silently not apply.
	for _ = 1, 10 do
		local found = false
		for _, zone in ipairs(ZONES) do
			if zone.Number == cfg.zoneNumber then
				found = true
				break
			end
		end
		if found or cfg.zoneNumber == nil then
			break
		end
		task.wait(1)
	end

	if applyConfig(cfg) then
		print("[Autofarm] Config loaded from " .. CONFIG_FILE)
		setStatus("Config loaded")
	end
end)

----------------------------------------------------------------------
-- Zone auto-discovery
----------------------------------------------------------------------

-- workspace.Build can finish replicating after the UI is built, and a zone may
-- be added by a live update, so rescan on a slow timer. refreshZones is a no-op
-- unless the discovered list actually differs, which keeps this invisible.
task.spawn(function()
	-- Catch late replication quickly, then settle into a slow poll.
	for _ = 1, 10 do
		task.wait(2)
		if refreshZones() then break end
	end

	while true do
		task.wait(60)
		pcall(refreshZones)
	end
end)
