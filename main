	Icon = "egg",
	LoadingTitle = "Break & Steal an Egg",
	LoadingSubtitle = "autofarm",
	ShowText = "Egg Autofarm",
	Theme = "Default",
	ToggleUIKeybind = "K",
	DisableRayfieldPrompts = false,
	DisableBuildWarnings = true,
	-- Rayfield's own saving stays off: restoring the zone clears the egg
	-- selection, and its restore order is dictionary order, so eggs could be
	-- applied before the zone and then wiped. The config module applies
	-- everything in a controlled order instead.
	ConfigurationSaving = { Enabled = false },
	Discord = { Enabled = false },
	KeySystem = false,
})

